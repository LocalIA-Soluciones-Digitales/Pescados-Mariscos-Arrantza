# Solo para desarrollo local: supabase functions serve crear-sesion-pago-stripe --env-file supabase/functions/crear-sesion-pago-stripe/.env.local
# En producción estos valores se configuran con `supabase secrets set NOMBRE=valor`,
# nunca se escriben en el código ni se suben al repositorio.

STRIPE_SECRET_KEY=
# Lista separada por comas — incluye el dominio de Vercel mientras arrantza.es
# no esté conectado como dominio propio.
ALLOWED_ORIGIN=https://arrantza.es,https://www.arrantza.es,https://pescados-mariscos-arrantza-main.vercel.app
