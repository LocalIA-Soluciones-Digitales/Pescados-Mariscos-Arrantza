# Solo para desarrollo local: supabase functions serve bascula-sync --env-file supabase/functions/bascula-sync/.env.local
# En producción estos valores se configuran con `supabase secrets set NOMBRE=valor`,
# nunca se escriben en el código ni se suben al repositorio.
#
# Un juego de credenciales por cada báscula/pescadería. El cron de cada
# terminal llama a esta función con {"origen": "pescaderia_1"} o
# {"origen": "pescaderia_2"} en el cuerpo, y la función busca las
# credenciales de ese origen.

BASCULA_PESCADERIA_1_PROXY_ID=
BASCULA_PESCADERIA_1_PUBLIC_KEY=
BASCULA_PESCADERIA_1_PRIVATE_KEY=

BASCULA_PESCADERIA_2_PROXY_ID=
BASCULA_PESCADERIA_2_PUBLIC_KEY=
BASCULA_PESCADERIA_2_PRIVATE_KEY=

BASCULA_CLIENTE_ID=
BASCULA_SYNC_SECRET=
