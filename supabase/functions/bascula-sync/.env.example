# nunca se escriben en el código ni se suben al repositorio.

BASCULA_PROXY_ID=
BASCULA_PUBLIC_KEY=
BASCULA_PRIVATE_KEY=
BASCULA_CLIENTE_ID=
BASCULA_SYNC_SECRET=
