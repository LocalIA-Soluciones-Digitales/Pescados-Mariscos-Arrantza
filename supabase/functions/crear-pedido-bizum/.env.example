# Solo para desarrollo local: supabase functions serve crear-pedido-bizum --env-file supabase/functions/crear-pedido-bizum/.env.local
# En producción estos valores se configuran con `supabase secrets set NOMBRE=valor`,
# nunca se escriben en el código ni se suben al repositorio.
#
# CALLMEBOT_APIKEY se obtiene una vez: añade el contacto de CallMeBot en el
# WhatsApp de David y sigue las instrucciones de activación en
# https://www.callmebot.com/blog/free-api-whatsapp-messages/
# Sin esta clave, el aviso automático simplemente se omite (whatsappSent:
# false) y el frontend abre el wa.me manual de siempre — no rompe nada.

CALLMEBOT_APIKEY=
CALLMEBOT_PHONE=34619609888
ALLOWED_ORIGIN=https://arrantza.es
