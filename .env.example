# Copia este archivo a .env.local y rellena los valores reales.
# Nunca subas .env ni .env.local al repositorio (ya están en .gitignore).
# Los valores se obtienen en Supabase Dashboard > Project Settings > API.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Clave del cliente (negocio) en la tabla `clientes`. Cada web de cliente usa la suya.
VITE_SITE_KEY=your-client-site-key
